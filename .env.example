# Copy this file to .env for local development, and add the same
# variables in Vercel → Project Settings → Environment Variables for deployment.

# Optional: enables real email delivery from the contact form via Resend
# (https://resend.com). Leave unset and the form still works — submissions
# are simply logged instead of emailed.
RESEND_API_KEY=

# The email address that should receive contact form messages.
CONTACT_TO_EMAIL=you@example.com
